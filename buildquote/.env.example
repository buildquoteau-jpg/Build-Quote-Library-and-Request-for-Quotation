# BuildQuote — Environment Variables
# Copy to .env.local and fill in values. Never commit real credentials.

# Supabase (shared production project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — gpt-4o OCR/parsing of uploaded materials lists (api/parse/route.ts)
# NOT Anthropic — parsing was migrated off Claude in an earlier session.
OPENAI_API_KEY=

# Resend — RFQ email dispatch
RESEND_API_KEY=
RESEND_FROM_EMAIL=rfq@buildquote.com.au

# App origin — https://buildquote.com.au in prod, http://localhost:3000 in dev
# Passkey routes derive their relying-party hostname from this.
NEXT_PUBLIC_APP_URL=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Trade Desk (search.buildquote.com.au) origin, used for cross-app links
NEXT_PUBLIC_MFP_URL=https://search.buildquote.com.au

# Vercel OIDC token — set automatically by Vercel, no local value needed
VERCEL_OIDC_TOKEN=
